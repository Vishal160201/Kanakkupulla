# Copy to .env and fill in. Never commit real values.

# --- Database (PostgreSQL, e.g. Neon) ---
DATABASE_URL=

# --- Auth (next-auth) ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=
NEXT_PUBLIC_APP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=

# --- Google Drive picker ---
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# --- Web push (VAPID) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Cron endpoints (Authorization: Bearer $CRON_SECRET) ---
CRON_SECRET=

# --- WhatsApp bot (set the same secret here and in whatsapp-bot-server) ---
WHATSAPP_BOT_URL=
WHATSAPP_BOT_SECRET=

# --- Optional: owner email for the personal tracker (/personal routes, personal recycle bin, master-admin lock) ---
PERSONAL_TRACKER_EMAIL=
NEXT_PUBLIC_PERSONAL_TRACKER_EMAIL=

# --- whatsapp-bot-server only ---
# ALLOWED_ORIGIN=
# PORT=3001
