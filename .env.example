# Copy to .env and fill in. Never commit real values.

# --- Database (PostgreSQL, e.g. Neon) ---
DATABASE_URL=

# --- Auth (next-auth) ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=
NEXT_PUBLIC_APP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=

# --- Google Drive picker ---
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# --- Web push (VAPID) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Cron endpoints (Authorization: Bearer $CRON_SECRET) ---
CRON_SECRET=

# --- Optional: primary owner email (personal recycle bin tab, master-admin lock) ---
NEXT_PUBLIC_PERSONAL_TRACKER_EMAIL=

