generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id        String    @id @default(cuid())
  name      String
  phone     String
  email     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]

  @@index([createdAt])
}

model Order {
  id           String   @id @default(cuid())
  bookingId    String   @unique
  package      Decimal  @default(0) @db.Decimal(12, 2)
  advance      Decimal  @default(0) @db.Decimal(12, 2)
  due          Decimal  @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  installments Json?
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Booking {
  id               String        @id @default(cuid())
  clientId         String
  category         String        @default("Wedding")
  date             DateTime
  time             String
  location         String
  status           String        @default("Confirmed")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  contractUrl      String?
  galleryUrl       String?
  attachments      Json?
  bookingNumber    String?       @unique
  createdById      String?
  customData       Json?
  deletedAt        DateTime?
  inclusions       Json?
  notes            String?
  packageName      String?
  photographers    Json?
  updatedById      String?
  galleryDelivered Boolean       @default(false)
  albumStatus      AlbumStatus   @default(PENDING)
  client           Client        @relation(fields: [clientId], references: [id])
  createdBy        User?         @relation("BookingCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?         @relation("BookingUpdatedBy", fields: [updatedById], references: [id])
  order            Order?
  invoice          Invoice?
  transactions     Transaction[]

  @@index([date])
  @@index([clientId])
  @@index([deletedAt])
  @@index([status])
  @@index([deletedAt, date])
  @@index([clientId, date])
  @@index([createdById])
  @@index([updatedById])
}

model SystemLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// Studio-wide business unit for ledger entries. The default shop is the SystemSetting
/// `default_shop_id` (one row, so there is always exactly one default).
model Shop {
  id                 String              @id @default(cuid())
  name               String              @unique
  icon               String?
  color              String              @default("#6366f1")
  isArchived         Boolean             @default(false)
  /// STUDIO shops share every module; other types get their own module set (src/lib/shopModules.ts)
  type               ShopType            @default(STUDIO)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  transactions       Transaction[]
  members            ShopMember[]
  inventoryProducts  InventoryProduct[]
  inventoryBills     InventoryBill[]
  inventoryCustomers InventoryCustomer[]
  produceItems       ProduceItem[]
  produceCollections ProduceCollection[]
  producePayments    ProducePayment[]
  produceBuyers      ProduceBuyer[]
  produceSales       ProduceSale[]
  produceReceipts    ProduceReceipt[]

  @@index([isArchived])
}

enum ShopType {
  STUDIO
  FERTILIZER
}

/// A member's role in one shop. Owners need no assignments; members only see their assigned shops.
model ShopMember {
  id        String     @id @default(cuid())
  shopId    String
  userId    String
  roleId    String
  createdAt DateTime   @default(now())
  shop      Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AccessRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([shopId, userId])
  @@index([userId])
  @@index([roleId])
}

/// Per-shop role (Admin / Staff) with a module → NONE/VIEW/MANAGE grid (src/lib/access.ts).
model AccessRole {
  id            String       @id @default(cuid())
  key           String       @unique
  name          String
  description   String?
  /// Record<ModuleKey, "NONE" | "VIEW" | "MANAGE">
  permissions   Json
  /// Record<NotificationType, boolean>
  notifications Json         @default("{}")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  assignments   ShopMember[]
}

model InventoryProduct {
  id         String          @id @default(cuid())
  shopId     String
  name       String
  /// Pack type: Bottle, Packet, Bag, Loose or Piece (older rows may hold other strings)
  unit       String
  /// Size of one pack (e.g. 50 for a 50 kg bag); null for Loose / Piece or when not set
  packSize   Decimal?        @db.Decimal(12, 3)
  /// Unit of packSize (ml, L, g, kg), or what a Loose product is sold by (kg, L, tonne)
  packUnit   String?
  price      Decimal         @db.Decimal(12, 2)
  isArchived Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  shop       Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  movements  StockMovement[]

  @@unique([shopId, name])
  @@index([shopId, isArchived])
}

enum InventoryBillKind {
  PURCHASE
  SALE
}

model InventoryBill {
  id            String             @id @default(cuid())
  shopId        String
  kind          InventoryBillKind
  billNumber    String
  date          DateTime
  customerId    String?
  supplierName  String?
  totalAmount   Decimal            @db.Decimal(12, 2)
  paidAmount    Decimal            @db.Decimal(12, 2)
  paymentMode   String
  notes         String?
  /// Daily Kanakku entry posted for this bill (none when nothing was paid)
  transactionId String?            @unique
  createdById   String?
  voidedAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer      InventoryCustomer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  transaction   Transaction?       @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  lines         StockMovement[]

  @@unique([shopId, billNumber])
  @@index([shopId, kind, date])
  @@index([customerId])
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
}

/// One stock change. `quantity` is signed: purchases add, sales subtract, adjustments either way.
model StockMovement {
  id          String            @id @default(cuid())
  shopId      String
  productId   String
  billId      String?
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3)
  unitPrice   Decimal           @db.Decimal(12, 2)
  amount      Decimal           @db.Decimal(12, 2)
  date        DateTime
  notes       String?
  createdById String?
  voidedAt    DateTime?
  createdAt   DateTime          @default(now())
  product     InventoryProduct  @relation(fields: [productId], references: [id], onDelete: Restrict)
  bill        InventoryBill?    @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([shopId, date])
  @@index([productId, voidedAt])
  @@index([billId])
}

/// Farmer / buyer of a fertilizer shop; credit balance = unpaid sale amounts − repayments.
model InventoryCustomer {
  id                 String              @id @default(cuid())
  shopId             String
  name               String
  phone              String?
  place              String?
  isArchived         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  shop               Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  bills              InventoryBill[]
  payments           CustomerPayment[]
  /// Produce (crops) bought from this farmer, and what we paid them for it
  produceCollections ProduceCollection[]
  producePayments    ProducePayment[]

  @@index([shopId, name])
}

model CustomerPayment {
  id             String            @id @default(cuid())
  shopId         String
  customerId     String
  amount         Decimal           @db.Decimal(12, 2)
  date           DateTime
  paymentMode    String
  notes          String?
  transactionId  String?           @unique
  createdById    String?
  voidedAt       DateTime?
  createdAt      DateTime          @default(now())
  customer       InventoryCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  transaction    Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  /// Set when this repayment is fertilizer credit deducted from a produce payment (no cash, no ledger entry)
  producePayment ProducePayment?

  @@index([customerId, voidedAt])
  @@index([shopId, date])
}

/// A crop / produce the shop buys from farmers and sells on; each shop manages its own list.
model ProduceItem {
  id          String              @id @default(cuid())
  shopId      String
  name        String
  /// Unit quantities and rates are in: kg, quintal or tonne
  unit        String              @default("kg")
  isArchived  Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  shop        Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  collections ProduceCollection[]
  sales       ProduceSale[]

  @@unique([shopId, name])
  @@index([shopId, isArchived])
}

/// Produce bought from a farmer at that day's rate per unit. The amount is owed to the farmer until paid.
model ProduceCollection {
  id          String            @id @default(cuid())
  shopId      String
  itemId      String
  customerId  String
  date        DateTime
  /// In the item's unit
  quantity    Decimal           @db.Decimal(12, 3)
  /// Per item unit
  rate        Decimal           @db.Decimal(12, 2)
  amount      Decimal           @db.Decimal(12, 2)
  notes       String?
  createdById String?
  voidedAt    DateTime?
  createdAt   DateTime          @default(now())
  shop        Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  item        ProduceItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  customer    InventoryCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([shopId, date])
  @@index([itemId, voidedAt])
  @@index([customerId, voidedAt])
}

/// A payment to a farmer for produce (all crops): cash (posted to Daily Kanakku) plus any fertilizer credit deducted.
model ProducePayment {
  id              String            @id @default(cuid())
  shopId          String
  customerId      String
  /// cashAmount + creditDeducted; what comes off the farmer's produce due
  amount          Decimal           @db.Decimal(12, 2)
  cashAmount      Decimal           @db.Decimal(12, 2)
  creditDeducted  Decimal           @db.Decimal(12, 2)
  date            DateTime
  paymentMode     String
  notes           String?
  /// Daily Kanakku expense for the cash part (none when everything was deducted)
  transactionId   String?           @unique
  /// Credit repayment recorded for the deducted part
  creditPaymentId String?           @unique
  createdById     String?
  voidedAt        DateTime?
  createdAt       DateTime          @default(now())
  shop            Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer        InventoryCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  transaction     Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  creditPayment   CustomerPayment?  @relation(fields: [creditPaymentId], references: [id], onDelete: Restrict)

  @@index([customerId, voidedAt])
  @@index([shopId, date])
}

/// Marketer / trader the shop sells produce to.
model ProduceBuyer {
  id         String           @id @default(cuid())
  shopId     String
  name       String
  phone      String?
  place      String?
  isArchived Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  shop       Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  sales      ProduceSale[]
  receipts   ProduceReceipt[]

  @@index([shopId, name])
}

/// Produce sold to a buyer (PS-0001…): quantity × rate; the unpaid part is the buyer's due.
model ProduceSale {
  id            String       @id @default(cuid())
  shopId        String
  itemId        String
  buyerId       String
  saleNumber    String
  date          DateTime
  /// In the item's unit
  quantity      Decimal      @db.Decimal(12, 3)
  rate          Decimal      @db.Decimal(12, 2)
  totalAmount   Decimal      @db.Decimal(12, 2)
  paidAmount    Decimal      @db.Decimal(12, 2)
  paymentMode   String
  notes         String?
  /// Daily Kanakku income for what was received now (none when nothing was paid)
  transactionId String?      @unique
  createdById   String?
  voidedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  shop          Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  item          ProduceItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  buyer         ProduceBuyer @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([shopId, saleNumber])
  @@index([shopId, date])
  @@index([itemId, voidedAt])
  @@index([buyerId])
}

/// Money received later from a buyer against their produce dues.
model ProduceReceipt {
  id            String       @id @default(cuid())
  shopId        String
  buyerId       String
  amount        Decimal      @db.Decimal(12, 2)
  date          DateTime
  paymentMode   String
  notes         String?
  transactionId String?      @unique
  createdById   String?
  voidedAt      DateTime?
  createdAt     DateTime     @default(now())
  shop          Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  buyer         ProduceBuyer @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([buyerId, voidedAt])
  @@index([shopId, date])
}

model Transaction {
  id              String           @id @default(cuid())
  amount          Decimal          @db.Decimal(12, 2)
  type            String
  date            DateTime
  category        String
  paymentMode     String
  description     String?
  status          String           @default("SETTLED")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  attachmentUrl   String?
  bookingId       String?
  customData      Json?
  transactionId   String?          @unique
  userId          String?
  productOrderId  String?
  deletedAt       DateTime?
  groupId         String?
  shopId          String
  booking         Booking?         @relation(fields: [bookingId], references: [id])
  productOrder    ProductOrder?    @relation(fields: [productOrderId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])
  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  inventoryBill   InventoryBill?
  customerPayment CustomerPayment?
  producePayment  ProducePayment?
  produceSale     ProduceSale?
  produceReceipt  ProduceReceipt?

  @@index([date])
  @@index([category])
  @@index([type])
  @@index([paymentMode])
  @@index([userId])
  @@index([date, type])
  @@index([userId, date])
  @@index([productOrderId])
  @@index([groupId])
  @@index([bookingId])
  @@index([deletedAt])
  @@index([shopId, date])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String?            @unique
  emailVerified      DateTime?
  password           String?
  image              String?
  emailNotifications Boolean            @default(true)
  idNumber           Int                @default(autoincrement())
  invitedAt          DateTime?
  phone              String?
  pushNotifications  Boolean            @default(true)
  role               Role               @default(MEMBER)
  status             UserStatus         @default(ACTIVE)
  whatsappNotifs     Boolean            @default(false)
  notificationPrefs  Json?
  accounts           Account[]
  createdBookings    Booking[]          @relation("BookingCreatedBy")
  updatedBookings    Booking[]          @relation("BookingUpdatedBy")
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  sessions           Session[]
  transactions       Transaction[]
  integrations       UserIntegration[]
  shopMemberships    ShopMember[]

  @@index([status])
}

model UserIntegration {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  connectedEmail String?
  customData     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model Product {
  id          String         @id @default(cuid())
  name        String
  description String?
  price       Decimal        @db.Decimal(12, 2)
  stock       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  orders      ProductOrder[]

  @@index([createdAt])
}

model ProductOrder {
  id             String        @id @default(cuid())
  productId      String
  quantity       Int           @default(1)
  status         String        @default("PENDING")
  clientName     String
  clientPhone    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customData     Json?
  orderNumber    String?       @unique
  dueDate        DateTime?
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  date           DateTime      @default(now())
  product        Product       @relation(fields: [productId], references: [id])
  transactions   Transaction[]

  @@index([productId])
  @@index([status])
  @@index([date])
  @@index([createdAt])
}

model FormLayout {
  id          String   @id @default(cuid())
  formKey     String   @unique
  name        String
  description String?
  schema      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id           String               @id @default(cuid())
  userId       String
  title        String
  message      String
  isRead       Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  actionUrl    String?
  entityId     String?
  entityType   String?
  type         NotificationType
  link         String?
  priority     NotificationPriority @default(NORMAL)
  snoozedUntil DateTime?
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecycleBin {
  id           String   @id @default(cuid())
  itemType     String
  itemId       String
  originalData Json
  trashedById  String?
  trashedAt    DateTime @default(now())

  @@index([itemType])
  @@index([trashedAt])
  @@index([itemType, itemId])
}

/// OWNER: full access everywhere. MEMBER: access only through per-shop role assignments.
enum Role {
  OWNER
  MEMBER
}

enum UserStatus {
  ACTIVE
  PENDING
  INACTIVE
}

enum AlbumStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_UPDATED
  PAYMENT_RECEIVED
  PAYMENT_OVERDUE
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  ORDER_DELIVERED
  GALLERY_DELIVERED
  HOT_DATE_ALERT
  ORDER_STATUS_STALE
  BOOKING_STATUS_STALE
  PAYMENT_DUE_REMINDER
  ADVANCE_NOT_COLLECTED
  GALLERY_NOT_DELIVERED
  ALBUM_PENDING_REMINDER
  BUDGET_EXCEEDED
}

enum NotificationPriority {
  HIGH
  NORMAL
  LOW
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  bookingId     String    @unique
  discount      Decimal   @default(0) @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  booking   Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lineItems InvoiceLineItem[]

  @@index([createdAt])
  @@index([deletedAt])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  rate        Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}
