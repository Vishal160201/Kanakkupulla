generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id        String    @id @default(cuid())
  name      String
  phone     String
  email     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]

  @@index([createdAt])
}

model Order {
  id           String   @id @default(cuid())
  bookingId    String   @unique
  package      Decimal  @default(0) @db.Decimal(12, 2)
  advance      Decimal  @default(0) @db.Decimal(12, 2)
  due          Decimal  @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  installments Json?
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Booking {
  id               String        @id @default(cuid())
  clientId         String
  category         String        @default("Wedding")
  date             DateTime
  time             String
  location         String
  status           String        @default("Confirmed")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  contractUrl      String?
  galleryUrl       String?
  attachments      Json?
  bookingNumber    String?       @unique
  createdById      String?
  customData       Json?
  deletedAt        DateTime?
  inclusions       Json?
  notes            String?
  packageName      String?
  photographers    Json?
  updatedById      String?
  galleryDelivered Boolean       @default(false)
  albumStatus      AlbumStatus   @default(PENDING)
  client           Client        @relation(fields: [clientId], references: [id])
  createdBy        User?         @relation("BookingCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?         @relation("BookingUpdatedBy", fields: [updatedById], references: [id])
  order            Order?
  invoice          Invoice?
  transactions     Transaction[]

  @@index([date])
  @@index([clientId])
  @@index([deletedAt])
  @@index([status])
  @@index([deletedAt, date])
  @@index([clientId, date])
  @@index([createdById])
  @@index([updatedById])
}

model SystemLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// Studio-wide business unit for ledger entries. The default shop is the SystemSetting
/// `default_shop_id` (one row, so there is always exactly one default).
model Shop {
  id                 String              @id @default(cuid())
  name               String              @unique
  icon               String?
  color              String              @default("#6366f1")
  isArchived         Boolean             @default(false)
  /// STUDIO shops share every module; other types get their own module set (src/lib/shopModules.ts)
  type               ShopType            @default(STUDIO)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  transactions       Transaction[]
  members            ShopMember[]
  inventoryProducts  InventoryProduct[]
  inventoryBills     InventoryBill[]
  inventoryCustomers InventoryCustomer[]
  produceItems       ProduceItem[]
  produceCollections ProduceCollection[]
  producePayments    ProducePayment[]
  produceBuyers      ProduceBuyer[]
  produceSales       ProduceSale[]
  produceReceipts    ProduceReceipt[]
  /// sha256 of the sync key the Kanakkupulla browser extension sends (cable shops); the key is shown once
  syncKeyHash        String?             @unique
  /// Last successful portal sync
  syncedAt           DateTime?
  /// Partner wallet balance in the provider's portal, as of walletSyncedAt (cable shops)
  walletBalance      Decimal?            @db.Decimal(12, 2)
  walletSyncedAt     DateTime?
  /// Warn when the wallet falls below this (cable shops); null = no warning
  lowWalletAlert     Decimal?            @db.Decimal(12, 2)
  /// Cable TV (TCCL): what a house pays each month; null = dues follow TCCL's bills instead
  cableMonthlyFee    Decimal?            @db.Decimal(12, 2)
  /// Cable TV: the reduced monthly amount for houses that keep a node (and its power supply); null = the usual amount
  cableNodeFee       Decimal?            @db.Decimal(12, 2)
  /// Cable TV: the first month ("2026-12") houses are charged for
  cableBillingFrom   String?
  /// What TCCL billed this month (`tcclBillMonth`, "2026-11"): the rises in its customer bills; paid to TCCL on the 15th
  tcclBillMonth      String?
  tcclBillAmount     Decimal             @default(0) @db.Decimal(12, 2)
  /// Cable TV: the latest month charges were added for (missed months are caught up from here)
  cableBilledMonth   String?
  /// TCCL (cable TV) portal: last sync and partner wallet; the columns above are for TIC Fiber
  tcclSyncedAt       DateTime?
  tcclWalletBalance  Decimal?            @db.Decimal(12, 2)
  tcclWalletSyncedAt DateTime?
  /// Shown in customer WhatsApp messages (cable shops)
  upiId              String?
  contactPhone       String?
  /// httpSMS gateway: sends SMS via the operator's own Android SIM. The key is never returned to the client.
  smsApiKey          String?
  /// The SIM's phone number messages are sent from (E.164, e.g. +9198…)
  smsFrom            String?
  /// Send renewal / due reminders by SMS automatically each day
  smsAutoReminders   Boolean             @default(false)
  /// Language for automatic and bulk SMS: "en" or "ta"
  smsLanguage        String              @default("en")
  /// sha256 of the token the Kanakkupulla SMS sender Android app uses to poll this shop's outbox
  smsDeviceTokenHash String?             @unique
  /// Last time the sender app polled (shows whether the phone is connected)
  smsDeviceSeenAt    DateTime?
  /// The one phone allowed to use the token: bound on its first poll, cleared on re-pair
  smsDeviceId        String?
  outboundSms        OutboundSms[]
  cableSubscribers   CableSubscriber[]
  cablePlans         CablePlan[]
  cablePayments      CablePayment[]
  cableComplaints    CableComplaint[]

  @@index([isArchived])
}

enum ShopType {
  STUDIO
  FERTILIZER
  CABLE
}

/// A member's role in one shop. Owners need no assignments; members only see their assigned shops.
model ShopMember {
  id        String     @id @default(cuid())
  shopId    String
  userId    String
  roleId    String
  createdAt DateTime   @default(now())
  shop      Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AccessRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([shopId, userId])
  @@index([userId])
  @@index([roleId])
}

/// Per-shop role (Admin / Staff) with a module → NONE/VIEW/MANAGE grid (src/lib/access.ts).
model AccessRole {
  id            String       @id @default(cuid())
  key           String       @unique
  name          String
  description   String?
  /// Record<ModuleKey, "NONE" | "VIEW" | "MANAGE">
  permissions   Json
  /// Record<NotificationType, boolean>
  notifications Json         @default("{}")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  assignments   ShopMember[]
}

model InventoryProduct {
  id         String          @id @default(cuid())
  shopId     String
  name       String
  /// Pack type: Bottle, Packet, Bag, Loose or Piece (older rows may hold other strings)
  unit       String
  /// Size of one pack (e.g. 50 for a 50 kg bag); null for Loose / Piece or when not set
  packSize   Decimal?        @db.Decimal(12, 3)
  /// Unit of packSize (ml, L, g, kg), or what a Loose product is sold by (kg, L, tonne)
  packUnit   String?
  price      Decimal         @db.Decimal(12, 2)
  isArchived Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  shop       Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  movements  StockMovement[]

  @@unique([shopId, name])
  @@index([shopId, isArchived])
}

enum InventoryBillKind {
  PURCHASE
  SALE
}

model InventoryBill {
  id            String             @id @default(cuid())
  shopId        String
  kind          InventoryBillKind
  billNumber    String
  date          DateTime
  customerId    String?
  supplierName  String?
  totalAmount   Decimal            @db.Decimal(12, 2)
  paidAmount    Decimal            @db.Decimal(12, 2)
  paymentMode   String
  notes         String?
  /// Daily Kanakku entry posted for this bill (none when nothing was paid)
  transactionId String?            @unique
  createdById   String?
  voidedAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer      InventoryCustomer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  transaction   Transaction?       @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  lines         StockMovement[]

  @@unique([shopId, billNumber])
  @@index([shopId, kind, date])
  @@index([customerId])
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
}

/// One stock change. `quantity` is signed: purchases add, sales subtract, adjustments either way.
model StockMovement {
  id          String            @id @default(cuid())
  shopId      String
  productId   String
  billId      String?
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3)
  unitPrice   Decimal           @db.Decimal(12, 2)
  amount      Decimal           @db.Decimal(12, 2)
  date        DateTime
  notes       String?
  createdById String?
  voidedAt    DateTime?
  createdAt   DateTime          @default(now())
  product     InventoryProduct  @relation(fields: [productId], references: [id], onDelete: Restrict)
  bill        InventoryBill?    @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([shopId, date])
  @@index([productId, voidedAt])
  @@index([billId])
}

/// Farmer / buyer of a fertilizer shop; credit balance = unpaid sale amounts − repayments.
model InventoryCustomer {
  id                 String              @id @default(cuid())
  shopId             String
  name               String
  phone              String?
  place              String?
  isArchived         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  shop               Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  bills              InventoryBill[]
  payments           CustomerPayment[]
  /// Produce (crops) bought from this farmer, and what we paid them for it
  produceCollections ProduceCollection[]
  producePayments    ProducePayment[]

  @@index([shopId, name])
}

model CustomerPayment {
  id             String            @id @default(cuid())
  shopId         String
  customerId     String
  amount         Decimal           @db.Decimal(12, 2)
  date           DateTime
  paymentMode    String
  notes          String?
  transactionId  String?           @unique
  createdById    String?
  voidedAt       DateTime?
  createdAt      DateTime          @default(now())
  customer       InventoryCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  transaction    Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  /// Set when this repayment is fertilizer credit deducted from a produce payment (no cash, no ledger entry)
  producePayment ProducePayment?

  @@index([customerId, voidedAt])
  @@index([shopId, date])
}

/// A crop / produce the shop buys from farmers and sells on; each shop manages its own list.
model ProduceItem {
  id          String              @id @default(cuid())
  shopId      String
  name        String
  /// Unit quantities and rates are in: kg, quintal or tonne
  unit        String              @default("kg")
  isArchived  Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  shop        Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  collections ProduceCollection[]
  sales       ProduceSale[]

  @@unique([shopId, name])
  @@index([shopId, isArchived])
}

/// Produce bought from a farmer at that day's rate per unit. The amount is owed to the farmer until paid.
model ProduceCollection {
  id          String            @id @default(cuid())
  shopId      String
  itemId      String
  customerId  String
  date        DateTime
  /// In the item's unit
  quantity    Decimal           @db.Decimal(12, 3)
  /// Per item unit
  rate        Decimal           @db.Decimal(12, 2)
  amount      Decimal           @db.Decimal(12, 2)
  notes       String?
  createdById String?
  voidedAt    DateTime?
  createdAt   DateTime          @default(now())
  shop        Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  item        ProduceItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  customer    InventoryCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([shopId, date])
  @@index([itemId, voidedAt])
  @@index([customerId, voidedAt])
}

/// A payment to a farmer for produce (all crops): cash (posted to Daily Kanakku) plus any fertilizer credit deducted.
model ProducePayment {
  id              String            @id @default(cuid())
  shopId          String
  customerId      String
  /// cashAmount + creditDeducted; what comes off the farmer's produce due
  amount          Decimal           @db.Decimal(12, 2)
  cashAmount      Decimal           @db.Decimal(12, 2)
  creditDeducted  Decimal           @db.Decimal(12, 2)
  date            DateTime
  paymentMode     String
  notes           String?
  /// Daily Kanakku expense for the cash part (none when everything was deducted)
  transactionId   String?           @unique
  /// Credit repayment recorded for the deducted part
  creditPaymentId String?           @unique
  createdById     String?
  voidedAt        DateTime?
  createdAt       DateTime          @default(now())
  shop            Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer        InventoryCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  transaction     Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  creditPayment   CustomerPayment?  @relation(fields: [creditPaymentId], references: [id], onDelete: Restrict)

  @@index([customerId, voidedAt])
  @@index([shopId, date])
}

/// Marketer / trader the shop sells produce to.
model ProduceBuyer {
  id         String           @id @default(cuid())
  shopId     String
  name       String
  phone      String?
  place      String?
  isArchived Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  shop       Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  sales      ProduceSale[]
  receipts   ProduceReceipt[]

  @@index([shopId, name])
}

/// Produce sold to a buyer (PS-0001…): quantity × rate; the unpaid part is the buyer's due.
model ProduceSale {
  id            String       @id @default(cuid())
  shopId        String
  itemId        String
  buyerId       String
  saleNumber    String
  date          DateTime
  /// In the item's unit
  quantity      Decimal      @db.Decimal(12, 3)
  rate          Decimal      @db.Decimal(12, 2)
  totalAmount   Decimal      @db.Decimal(12, 2)
  paidAmount    Decimal      @db.Decimal(12, 2)
  paymentMode   String
  notes         String?
  /// Daily Kanakku income for what was received now (none when nothing was paid)
  transactionId String?      @unique
  createdById   String?
  voidedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  shop          Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  item          ProduceItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  buyer         ProduceBuyer @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([shopId, saleNumber])
  @@index([shopId, date])
  @@index([itemId, voidedAt])
  @@index([buyerId])
}

/// Money received later from a buyer against their produce dues.
model ProduceReceipt {
  id            String       @id @default(cuid())
  shopId        String
  buyerId       String
  amount        Decimal      @db.Decimal(12, 2)
  date          DateTime
  paymentMode   String
  notes         String?
  transactionId String?      @unique
  createdById   String?
  voidedAt      DateTime?
  createdAt     DateTime     @default(now())
  shop          Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  buyer         ProduceBuyer @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([buyerId, voidedAt])
  @@index([shopId, date])
}

/// An internet / cable subscriber copied from the provider's portal by the browser extension (src/lib/cableSync.ts).
model CableSubscriber {
  id          String           @id @default(cuid())
  shopId      String
  /// Portal it comes from: TIC_FIBER (TCCL later)
  provider    String
  /// The portal's user / account id
  externalId  String
  name        String
  phone       String?
  altPhone    String?
  /// As the portal shows it: Active, Inactive, …
  status      String
  plan        String?
  /// MAC id (TIC Fiber) or STB serial number (TCCL)
  macId       String?
  /// Set-top box VC number (TCCL)
  vcNumber    String?
  /// TCCL's total billed for this customer as last seen; a rise is charged as a monthly bill
  billedTotal Decimal?         @db.Decimal(12, 2)
  address     String?
  area        String?
  createdOn   DateTime?
  activatedAt DateTime?
  renewedAt   DateTime?
  expiresAt   DateTime?
  /// Set when the subscriber no longer appears in the portal; cleared if they come back
  goneAt      DateTime?
  /// Name / phone typed in by the shop: kept in `name` / `phone` instead of the portal's value on every sync
  customName  String?
  customPhone String?
  /// Shop-entered extras the portal doesn't have
  tamilName   String?
  /// The VC number of the box this subscriber had before (TCCL)
  oldVcNumber String?
  /// The shop's own grouping (area / line, e.g. a sheet of the old register)
  groupName   String?
  /// Cable TV: keeps a node with its power supply (pays the shop's node amount)
  nodeHouse   Boolean          @default(false)
  /// Cable TV: this house's own monthly amount (0 = free); null = the shop's amount
  monthlyFee  Decimal?         @db.Decimal(12, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  shop        Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  renewals    CableRenewal[]
  payments    CablePayment[]
  complaints  CableComplaint[]

  @@unique([shopId, provider, externalId])
  @@index([shopId, expiresAt])
}

/// A charge on a subscriber: an internet renewal (the sync saw the expiry move forward), a TCCL monthly bill
/// (TCCL's billed total went up) or the opening balance carried over from TCCL. Dues = charges − payments.
model CableRenewal {
  id             String          @id @default(cuid())
  subscriberId   String
  /// RENEWAL | BILL | OPENING | MONTHLY (the shop's fixed monthly amount)
  kind           String          @default("RENEWAL")
  /// MONTHLY only: the month it is for ("2026-12"), one per subscriber
  period         String?
  plan           String?
  /// The plan's price when it was renewed (editable); null until the plan has a price
  amount         Decimal?        @db.Decimal(12, 2)
  renewedAt      DateTime?
  previousExpiry DateTime?
  /// Renewals only (keeps a renewal from being recorded twice)
  expiresAt      DateTime?
  createdAt      DateTime        @default(now())
  subscriber     CableSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, expiresAt])
  @@unique([subscriberId, period])
}

/// A plan name seen in the portal, with the shop's selling price for one renewal.
model CablePlan {
  id        String   @id @default(cuid())
  shopId    String
  provider  String
  name      String
  /// What the shop charges the subscriber per renewal; null until set
  price     Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@unique([shopId, provider, name])
}

/// Money collected from a subscriber against their renewal dues; posted to Daily Kanakku.
model CablePayment {
  id            String          @id @default(cuid())
  shopId        String
  subscriberId  String
  amount        Decimal         @db.Decimal(12, 2)
  date          DateTime
  paymentMode   String
  notes         String?
  transactionId String?         @unique
  /// Who collected it (user id)
  createdById   String?
  voidedAt      DateTime?
  createdAt     DateTime        @default(now())
  shop          Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  subscriber    CableSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
  transaction   Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([shopId, date])
  @@index([subscriberId, voidedAt])
}

/// A fault reported by a subscriber (no signal, slow speed, …), fixed by line staff.
model CableComplaint {
  id           String          @id @default(cuid())
  shopId       String
  subscriberId String
  issue        String
  notes        String?
  /// User id of the line staff member it's assigned to
  assignedToId String?
  createdById  String?
  fixedAt      DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  shop         Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  subscriber   CableSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

  @@index([shopId, fixedAt])
  @@index([subscriberId])
}

/// One SMS queued for the shop's own Android sender app to send via its SIM (our free alternative to httpSMS).
model OutboundSms {
  id           String   @id @default(cuid())
  shopId       String
  /// Recipient in E.164 (+91…)
  to           String
  content      String
  /// pending → sending (claimed by the app) → sent | failed
  status       String   @default("pending")
  subscriberId String?
  createdById  String?
  /// Failure reason reported by the app
  reason       String?
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
}

model Transaction {
  id              String           @id @default(cuid())
  amount          Decimal          @db.Decimal(12, 2)
  type            String
  date            DateTime
  category        String
  paymentMode     String
  description     String?
  status          String           @default("SETTLED")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  attachmentUrl   String?
  bookingId       String?
  customData      Json?
  transactionId   String?          @unique
  userId          String?
  productOrderId  String?
  deletedAt       DateTime?
  groupId         String?
  shopId          String
  booking         Booking?         @relation(fields: [bookingId], references: [id])
  productOrder    ProductOrder?    @relation(fields: [productOrderId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])
  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  inventoryBill   InventoryBill?
  customerPayment CustomerPayment?
  producePayment  ProducePayment?
  produceSale     ProduceSale?
  produceReceipt  ProduceReceipt?
  cablePayment    CablePayment?

  @@index([date])
  @@index([category])
  @@index([type])
  @@index([paymentMode])
  @@index([userId])
  @@index([date, type])
  @@index([userId, date])
  @@index([productOrderId])
  @@index([groupId])
  @@index([bookingId])
  @@index([deletedAt])
  @@index([shopId, date])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String?            @unique
  /// Optional sign-in name (lowercase); people can sign in with this or the email
  username           String?            @unique
  emailVerified      DateTime?
  password           String?
  image              String?
  emailNotifications Boolean            @default(true)
  idNumber           Int                @default(autoincrement())
  invitedAt          DateTime?
  phone              String?
  pushNotifications  Boolean            @default(true)
  role               Role               @default(MEMBER)
  status             UserStatus         @default(ACTIVE)
  whatsappNotifs     Boolean            @default(false)
  notificationPrefs  Json?
  /// Sessions signed in before this are ended (set when the password changes)
  passwordChangedAt  DateTime?
  accounts           Account[]
  createdBookings    Booking[]          @relation("BookingCreatedBy")
  updatedBookings    Booking[]          @relation("BookingUpdatedBy")
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  sessions           Session[]
  transactions       Transaction[]
  integrations       UserIntegration[]
  shopMemberships    ShopMember[]
  moneyAccounts      MoneyAccount[]
  moneyImports       MoneyImport[]
  moneyTransactions  MoneyTransaction[]
  moneyCategories    MoneyCategory[]
  moneyRules         MoneyRule[]
  moneyCommitments   MoneyCommitment[]
  moneyPreference    MoneyPreference?

  @@index([status])
}

model UserIntegration {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  connectedEmail String?
  customData     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model Product {
  id          String         @id @default(cuid())
  name        String
  description String?
  price       Decimal        @db.Decimal(12, 2)
  stock       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  orders      ProductOrder[]

  @@index([createdAt])
}

model ProductOrder {
  id             String        @id @default(cuid())
  productId      String
  quantity       Int           @default(1)
  status         String        @default("PENDING")
  clientName     String
  clientPhone    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customData     Json?
  orderNumber    String?       @unique
  dueDate        DateTime?
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  date           DateTime      @default(now())
  product        Product       @relation(fields: [productId], references: [id])
  transactions   Transaction[]

  @@index([productId])
  @@index([status])
  @@index([date])
  @@index([createdAt])
}

model FormLayout {
  id          String   @id @default(cuid())
  formKey     String   @unique
  name        String
  description String?
  schema      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id           String               @id @default(cuid())
  userId       String
  title        String
  message      String
  isRead       Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  actionUrl    String?
  entityId     String?
  entityType   String?
  type         NotificationType
  link         String?
  priority     NotificationPriority @default(NORMAL)
  snoozedUntil DateTime?
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecycleBin {
  id           String   @id @default(cuid())
  itemType     String
  itemId       String
  originalData Json
  trashedById  String?
  trashedAt    DateTime @default(now())

  @@index([itemType])
  @@index([trashedAt])
  @@index([itemType, itemId])
}

/// OWNER: full access everywhere. MEMBER: access only through per-shop role assignments.
enum Role {
  OWNER
  MEMBER
}

enum UserStatus {
  ACTIVE
  PENDING
  INACTIVE
}

enum AlbumStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_UPDATED
  PAYMENT_RECEIVED
  PAYMENT_OVERDUE
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  ORDER_DELIVERED
  GALLERY_DELIVERED
  HOT_DATE_ALERT
  ORDER_STATUS_STALE
  BOOKING_STATUS_STALE
  PAYMENT_DUE_REMINDER
  ADVANCE_NOT_COLLECTED
  GALLERY_NOT_DELIVERED
  ALBUM_PENDING_REMINDER
  BUDGET_EXCEEDED
}

enum NotificationPriority {
  HIGH
  NORMAL
  LOW
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  bookingId     String    @unique
  discount      Decimal   @default(0) @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  booking   Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lineItems InvoiceLineItem[]

  @@index([createdAt])
  @@index([deletedAt])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  rate        Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// Fixed-window counters for rate limiting (src/lib/rateLimit.ts); old rows are purged daily
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// ---------------------------------------------------------------------------
// Personal money tracker (/money). Private to the tracker account (MONEY_TRACKER_EMAIL):
// see src/lib/money/access.ts. Money is numeric(14,2) and leaves the API as decimal
// strings, never floats. Rows are always scoped by userId.
// ---------------------------------------------------------------------------

enum MoneyAccountType {
  BANK
  CREDIT_CARD
}

enum MoneyImportSource {
  PDF
  CSV
  MANUAL
  XLSX
  AA_JSON
  OCR
}

enum MoneyImportStatus {
  OK
  NEEDS_REVIEW
}

enum MoneyDirection {
  DEBIT
  CREDIT
}

enum MoneyTxnKind {
  EXPENSE
  INCOME
  SALARY
  INTEREST
  SELF_TRANSFER
  CARD_PAYMENT
  CARD_REFUND
  PASS_THROUGH
  REIMBURSEMENT
}

enum MoneyRuleField {
  NARRATION
  COUNTERPARTY
  UPI_ID
  MERCHANT
}

enum MoneyCommitmentType {
  SAVINGS_GOAL
  CARD_BILL
  CARD_EMI
  RECEIVABLE
  PAYABLE
  EXPECTED_INCOME
}

enum MoneyCommitmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

/// A bank account or credit card the tracker follows.
model MoneyAccount {
  id                String           @id @default(cuid())
  userId            String
  name              String
  institution       String
  type              MoneyAccountType
  /// Last 4 digits only; full account and card numbers are never stored
  last4             String?
  /// Strings that identify this account inside other accounts' narrations (UPI handle, IFSC, partial number)
  ownIdentifiers    String[]         @default([])
  /// Counted in "available money" (Bal for EMI)
  isPool            Boolean          @default(false)
  lowBalanceAlert   Decimal          @default(1000) @db.Decimal(14, 2)
  /// Credit cards: day of month the billing cycle starts, and the bill due day
  cycleStartDay     Int?
  dueDay            Int?
  creditLimit       Decimal?         @db.Decimal(14, 2)
  /// Bank accounts with no statement imported yet: balance typed in by hand, as of manualBalanceAsOf
  manualBalance     Decimal?         @db.Decimal(14, 2)
  manualBalanceAsOf DateTime?        @db.Date
  /// Credit cards: amount used as of outstandingAsOf, the starting point before spends are tracked
  outstanding       Decimal?         @db.Decimal(14, 2)
  outstandingAsOf   DateTime?        @db.Date
  color             String           @default("#f97316")
  sortOrder         Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  imports      MoneyImport[]
  transactions MoneyTransaction[]
  commitments  MoneyCommitment[]
  /// Card payments made to this card from a bank account
  paymentsIn   MoneyTransaction[] @relation("MoneyCounterAccount")
  rules        MoneyRule[]

  @@index([userId, sortOrder])
}

/// One imported file (or manual batch) of transactions.
model MoneyImport {
  id             String            @id @default(cuid())
  userId         String
  accountId      String
  sourceType     MoneyImportSource
  filename       String?
  /// SHA-256 of the uploaded file, so the same file isn't imported twice
  fileHash       String?
  periodFrom     DateTime?         @db.Date
  periodTo       DateTime?         @db.Date
  openingBalance Decimal?          @db.Decimal(14, 2)
  closingBalance Decimal?          @db.Decimal(14, 2)
  status         MoneyImportStatus @default(OK)
  /// Validation messages: [{ code, message, row? }]
  warnings       Json              @default("[]")
  importedAt     DateTime          @default(now())

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      MoneyAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transactions MoneyTransaction[]

  @@unique([accountId, fileHash])
  @@index([userId, importedAt])
}

/// One transaction, in a shape kept close to the ReBIT Account Aggregator FI schema.
model MoneyTransaction {
  id               String         @id @default(cuid())
  userId           String
  accountId        String
  importId         String?
  txnDate          DateTime       @db.Date
  /// HH:MM:SS when the source has it (KVB, card spends)
  txnTime          String?
  /// Order within the statement, so the last row of a day gives the day's closing balance
  seq              Int            @default(0)
  valueDate        DateTime?      @db.Date
  /// Encrypted (src/lib/money/crypto.ts), like counterparty, upiId and note
  narration        String
  /// Reference number with leading zeros stripped ("" when the source has none)
  refNo            String         @default("")
  amount           Decimal        @db.Decimal(14, 2)
  direction        MoneyDirection
  balanceAfter     Decimal?       @db.Decimal(14, 2)
  counterparty     String?
  upiId            String?
  categoryId       String?
  kind             MoneyTxnKind   @default(EXPENSE)
  /// The other side of a self transfer
  linkedTxnId      String?        @unique
  commitmentId     String?
  /// Card payments: the card that was paid
  counterAccountId String?
  note             String?
  /// HMAC of date|time|ref|amount|direction|balance (cards: date|time|merchant|amount), so
  /// re-importing a statement can't duplicate rows and the key reveals nothing
  dedupeKey        String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  counterAccount MoneyAccount?             @relation("MoneyCounterAccount", fields: [counterAccountId], references: [id], onDelete: SetNull)
  account        MoneyAccount              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  import         MoneyImport?              @relation(fields: [importId], references: [id], onDelete: SetNull)
  category       MoneyCategory?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  linkedTxn      MoneyTransaction?         @relation("MoneySelfTransfer", fields: [linkedTxnId], references: [id], onDelete: SetNull)
  linkedBy       MoneyTransaction?         @relation("MoneySelfTransfer")
  commitment     MoneyCommitment?          @relation(fields: [commitmentId], references: [id], onDelete: SetNull)
  schedules      MoneyCommitmentSchedule[]

  @@unique([accountId, dedupeKey])
  @@index([userId, txnDate])
  @@index([accountId, txnDate])
  @@index([userId, kind])
  @@index([categoryId])
  @@index([importId])
}

model MoneyCategory {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#64748b")
  /// Phosphor icon name, e.g. "ph-fork-knife"
  icon      String   @default("ph-tag")
  parentId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       MoneyCategory?     @relation("MoneyCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     MoneyCategory[]    @relation("MoneyCategoryTree")
  transactions MoneyTransaction[]
  rules        MoneyRule[]

  @@unique([userId, name])
}

/// Auto-categorisation: the first matching rule (lowest priority number) wins.
model MoneyRule {
  id              String          @id @default(cuid())
  userId          String
  priority        Int             @default(100)
  field           MoneyRuleField  @default(NARRATION)
  /// Encrypted
  pattern         String
  isRegex         Boolean         @default(false)
  /// Only debits or only credits (e.g. EXC PYMT credits are card refunds)
  direction       MoneyDirection?
  categoryId      String?
  kind            MoneyTxnKind?
  /// Card payment rules: the card being paid
  targetAccountId String?
  createdAt       DateTime        @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      MoneyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  targetAccount MoneyAccount?  @relation(fields: [targetAccountId], references: [id], onDelete: SetNull)

  @@index([userId, priority])
}

/// Savings goals, card bills and EMIs, money owed either way, expected income.
model MoneyCommitment {
  id                 String                @id @default(cuid())
  userId             String
  /// Encrypted, like notes and matchPattern
  name               String
  type               MoneyCommitmentType
  accountId          String?
  totalAmount        Decimal               @db.Decimal(14, 2)
  notes              String?
  /// Text that identifies its payments in narrations (e.g. the person's name or UPI ID)
  matchPattern       String?
  sortOrder          Int                   @default(0)
  status             MoneyCommitmentStatus @default(ACTIVE)
  /// A card EMI and the receivable that funds it (a friend paying back their share)
  linkedCommitmentId String?               @unique
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      MoneyAccount?             @relation(fields: [accountId], references: [id], onDelete: SetNull)
  linked       MoneyCommitment?          @relation("MoneyCommitmentLink", fields: [linkedCommitmentId], references: [id], onDelete: SetNull)
  linkedBy     MoneyCommitment?          @relation("MoneyCommitmentLink")
  schedule     MoneyCommitmentSchedule[]
  transactions MoneyTransaction[]

  @@index([userId, status])
}

model MoneyCommitmentSchedule {
  id            String    @id @default(cuid())
  commitmentId  String
  dueDate       DateTime  @db.Date
  amount        Decimal   @db.Decimal(14, 2)
  paidAmount    Decimal   @default(0) @db.Decimal(14, 2)
  paidOn        DateTime? @db.Date
  transactionId String?

  commitment  MoneyCommitment   @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  transaction MoneyTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([commitmentId, dueDate])
  @@index([transactionId])
}

/// Per-user tracker settings (salary keyword, thresholds, forecast options): see src/lib/money/preferences.ts
model MoneyPreference {
  userId    String   @id
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
