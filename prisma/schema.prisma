generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id        String    @id @default(cuid())
  name      String
  phone     String
  email     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]

  @@index([createdAt])
}

model Order {
  id           String   @id @default(cuid())
  bookingId    String   @unique
  package      Decimal  @default(0) @db.Decimal(12, 2)
  advance      Decimal  @default(0) @db.Decimal(12, 2)
  due          Decimal  @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  installments Json?
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Booking {
  id               String        @id @default(cuid())
  clientId         String
  category         String        @default("Wedding")
  date             DateTime
  time             String
  location         String
  status           String        @default("Confirmed")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  contractUrl      String?
  galleryUrl       String?
  attachments      Json?
  bookingNumber    String?       @unique
  createdById      String?
  customData       Json?
  deletedAt        DateTime?
  inclusions       Json?
  notes            String?
  packageName      String?
  photographers    Json?
  updatedById      String?
  galleryDelivered Boolean       @default(false)
  albumStatus      AlbumStatus   @default(PENDING)
  client           Client        @relation(fields: [clientId], references: [id])
  createdBy        User?         @relation("BookingCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?         @relation("BookingUpdatedBy", fields: [updatedById], references: [id])
  order            Order?
  invoice          Invoice?
  transactions     Transaction[]

  @@index([date])
  @@index([clientId])
  @@index([deletedAt])
  @@index([status])
  @@index([deletedAt, date])
  @@index([clientId, date])
  @@index([createdById])
  @@index([updatedById])
}

model SystemLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Shop {
  id           String        @id @default(cuid())
  name         String
  icon         String?
  color        String        @default("#6366f1")
  isDefault    Boolean       @default(false)
  isArchived   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@index([isDefault])
  @@index([isArchived])
}

model Transaction {
  id             String        @id @default(cuid())
  amount         Decimal       @db.Decimal(12, 2)
  type           String
  date           DateTime
  category       String
  paymentMode    String
  description    String?
  status         String        @default("SETTLED")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  attachmentUrl  String?
  bookingId      String?
  customData     Json?
  transactionId  String?       @unique
  userId         String?
  productOrderId String?
  deletedAt      DateTime?
  groupId        String?
  shopId         String?
  booking        Booking?      @relation(fields: [bookingId], references: [id])
  productOrder   ProductOrder? @relation(fields: [productOrderId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])
  shop           Shop?         @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@index([date])
  @@index([category])
  @@index([type])
  @@index([paymentMode])
  @@index([userId])
  @@index([date, type])
  @@index([userId, date])
  @@index([productOrderId])
  @@index([groupId])
  @@index([bookingId])
  @@index([deletedAt])
  @@index([shopId, date])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String?            @unique
  emailVerified      DateTime?
  password           String?
  image              String?
  emailNotifications Boolean            @default(true)
  idNumber           Int                @default(autoincrement())
  invitedAt          DateTime?
  phone              String?
  pushNotifications  Boolean            @default(true)
  role               Role               @default(STAFF)
  status             UserStatus         @default(ACTIVE)
  whatsappNotifs     Boolean            @default(false)
  notificationPrefs  Json?
  accounts           Account[]
  createdBookings    Booking[]          @relation("BookingCreatedBy")
  updatedBookings    Booking[]          @relation("BookingUpdatedBy")
  categoryBudgets    CategoryBudget[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  sessions           Session[]
  transactions       Transaction[]
  integrations       UserIntegration[]

  @@index([status])
}

model UserIntegration {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  connectedEmail String?
  customData     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model RolePermission {
  id         String  @id @default(cuid())
  role       Role
  permission String
  enabled    Boolean @default(false)

  @@unique([role, permission])
  @@index([role])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model Product {
  id          String         @id @default(cuid())
  name        String
  description String?
  price       Decimal        @db.Decimal(12, 2)
  stock       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  orders      ProductOrder[]

  @@index([createdAt])
}

model ProductOrder {
  id             String        @id @default(cuid())
  productId      String
  quantity       Int           @default(1)
  status         String        @default("PENDING")
  clientName     String
  clientPhone    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customData     Json?
  orderNumber    String?       @unique
  dueDate        DateTime?
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  date           DateTime      @default(now())
  product        Product       @relation(fields: [productId], references: [id])
  transactions   Transaction[]

  @@index([productId])
  @@index([status])
  @@index([date])
  @@index([createdAt])
}

model FormLayout {
  id          String   @id @default(cuid())
  formKey     String   @unique
  name        String
  description String?
  schema      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id           String               @id @default(cuid())
  userId       String
  title        String
  message      String
  isRead       Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  actionUrl    String?
  entityId     String?
  entityType   String?
  type         NotificationType
  link         String?
  priority     NotificationPriority @default(NORMAL)
  snoozedUntil DateTime?
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecycleBin {
  id           String   @id @default(cuid())
  itemType     String
  itemId       String
  originalData Json
  trashedById  String?
  trashedAt    DateTime @default(now())

  @@index([itemType])
  @@index([trashedAt])
  @@index([itemType, itemId])
}

model CategoryBudget {
  id           String   @id @default(cuid())
  category     String
  monthlyLimit Decimal  @db.Decimal(12, 2)
  month        Int
  year         Int
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@unique([category, month, year, userId])
  @@index([userId])
  @@index([category, month, year])
}

enum Role {
  ADMIN
  STAFF
  PHOTOGRAPHER
}

enum UserStatus {
  ACTIVE
  PENDING
  INACTIVE
}

enum AlbumStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_UPDATED
  PAYMENT_RECEIVED
  PAYMENT_OVERDUE
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  ORDER_DELIVERED
  GALLERY_DELIVERED
  HOT_DATE_ALERT
  ORDER_STATUS_STALE
  BOOKING_STATUS_STALE
  PAYMENT_DUE_REMINDER
  ADVANCE_NOT_COLLECTED
  GALLERY_NOT_DELIVERED
  ALBUM_PENDING_REMINDER
  BUDGET_EXCEEDED
}

enum NotificationPriority {
  HIGH
  NORMAL
  LOW
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  bookingId     String    @unique
  discount      Decimal   @default(0) @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  booking   Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lineItems InvoiceLineItem[]

  @@index([createdAt])
  @@index([deletedAt])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  rate        Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}
